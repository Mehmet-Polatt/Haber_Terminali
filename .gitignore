# ==============================================================================
# Haber Terminali - Comprehensive .gitignore
# Covers Python (FastAPI/Backend), React Native / Expo (Mobile), Node, OS & IDEs
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Data (Securing Secrets)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
mobil/.env
mobil/.env.*
mobil/.env.local

# DO NOT ignore example template files
!.env.example
!mobil/.env.example

# Private keys, certificates, credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
*.jks
credentials.json
client_secret*.json

# ------------------------------------------------------------------------------
# 2. Python & Backend
# ------------------------------------------------------------------------------
# Bytecode & compiled files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Distribution & packaging
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Type Checking
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# Databases & local data
*.db
*.sqlite
*.sqlite3
*.sql
*.dump

# Logs
*.log
logs/

# ------------------------------------------------------------------------------
# 3. JavaScript / Node.js & React Native / Expo
# ------------------------------------------------------------------------------
node_modules/
mobil/node_modules/
.npm
.yarn/cache
.yarn/unplugged

# Expo cache and artifacts
.expo/
mobil/.expo/
.expo-shared/
mobil/.expo-shared/
web-build/
mobil/web-build/
.metro-health-check*

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Fastlane / Bundles
*.jsbundle
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots

# ------------------------------------------------------------------------------
# 4. Mobile Native Build Artifacts (Android & iOS)
# ------------------------------------------------------------------------------
# Android
*.apk
*.aab
*.dex
*.class
.gradle/
local.properties
android/app/build/
android/.gradle/

# iOS
*.ipa
*.dSYM.zip
*.dSYM
DerivedData/
Pods/
mobil/ios/Pods/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# ------------------------------------------------------------------------------
# 5. Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# 6. IDEs & Editors
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
