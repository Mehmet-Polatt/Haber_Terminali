# ==============================================================================
# Haber Terminali - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your '.env' file to version control.
# ==============================================================================

# Database Connection URL
# For MySQL (aiomysql async driver):
# Format: mysql+aiomysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+aiomysql://root:your_mysql_password_here@localhost:3306/haber_terminali

# Alternatively, for local SQLite development:
# DATABASE_URL=sqlite+aiosqlite:///./haber_terminali.db

# Google Gemini API Key for AI news analysis (google-genai SDK)
# Get your API key from Google AI Studio: https://aistudio.google.com/
AI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here