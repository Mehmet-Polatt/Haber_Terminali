# ==============================================================================
# Haber Terminali Mobil (React Native / Expo) - Environment Variables Template
# Copy this file to '.env' and adjust the API URL according to your setup.
# NEVER commit your '.env' file to version control.
# ==============================================================================

# Backend API URL (EXPO_PUBLIC_ prefix is required for Expo SDK 49+)
# - Testing on Physical Device: Use your computer's local Wi-Fi IP (e.g., http://192.168.1.105:8000)
# - Testing on Android Emulator: Use http://10.0.2.2:8000
# - Testing on iOS Simulator or Web: Use http://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
